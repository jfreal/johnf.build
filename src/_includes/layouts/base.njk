<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('consent', 'default', {
            analytics_storage: 'granted',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied'
        });
        gtag('js', new Date());

        gtag('config', '{{ site.gaId }}');
    </script>
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}" />
{%- set canonical = site.url + (page.url | cleanUrl) %}
    <link rel="canonical" href="{{ canonical }}" />
{% if ogTitle %}
    <meta property="og:title" content="{{ ogTitle }}" />
    <meta property="og:description" content="{{ ogDescription }}" />
    <meta property="og:type" content="{{ ogType | default('article') }}" />
    <meta property="og:url" content="{{ canonical }}" />
    <meta name="twitter:card" content="summary" />
{% endif %}
{%- if nav == "home" %}
    <script type="application/ld+json">
{{ {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": site.url + "/#john",
    "name": "John Farrell",
    "url": site.url + "/",
    "jobTitle": "Builder",
    "sameAs": [site.linkedin, site.github]
} | dump | safe }}
    </script>
{%- endif %}
{%- if product and product.page %}
    <script type="application/ld+json">
{{ {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": product.name,
    "description": product.desc,
    "url": product.url or (site.url + "/" + product.page),
    "applicationCategory": product.tag.split(" · ")[0],
    "author": { "@type": "Person", "@id": site.url + "/#john", "name": "John Farrell", "url": site.url + "/" }
} | dump | safe }}
    </script>
{%- endif %}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#218da6" />
    <meta name="theme-color" content="#fffff0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet" />

    <link rel="stylesheet" href="/css/site.css" />
</head>

<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
        <div class="wrap header-inner">
            <a class="mark" href="/" aria-label="Home">
                <span class="mark-ink">jf</span>
                <span class="mark-dot" aria-hidden="true"></span>
            </a>
            <nav class="primary-nav" aria-label="Primary">
{%- if nav != "home" %}
                <a href="/">← Home</a>
{%- endif %}
{%- if nav == "stack" %}
                <span class="nav-current nav-pill" aria-current="page">Stack</span>
{%- else %}
                <a class="nav-pill" href="/stack">Stack</a>
{%- endif %}
{%- set here = page.url | cleanUrl %}
{%- set onArticle = false %}
{%- for article in articles %}{% if article.url == here %}{% set onArticle = true %}{% endif %}{% endfor %}
                <details class="nav-writing">
                    <summary{% if onArticle %} class="is-current"{% endif %}>Writing<span class="nav-caret" aria-hidden="true"></span></summary>
                    <ul class="nav-menu">
{%- for article in articles %}
{%- if article.url == here %}
                        <li><span class="nav-current" aria-current="page">{{ article.title }}</span></li>
{%- else %}
                        <li><a href="{{ article.url }}">{{ article.title }}</a></li>
{%- endif %}
{%- endfor %}
                    </ul>
                </details>
{%- if page.url | cleanUrl == "/nightforge" %}
                <span class="nav-current nav-pill" aria-current="page"><img class="nav-menu-icon" src="/img/nightforge-icon.png" alt="" width="20" height="24" />NightForge</span>
{%- else %}
                <a class="nav-pill" href="/nightforge"><img class="nav-menu-icon" src="/img/nightforge-icon.png" alt="" width="20" height="24" />NightForge</a>
{%- endif %}
                <span class="nav-social">
                    <a class="nav-icon" href="{{ site.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
                        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 4.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    </a>
                    <a class="nav-icon" href="{{ site.github }}" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
                        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                    </a>
                </span>
            </nav>
        </div>
    </header>

    <main id="main">
{{ content | safe }}
    </main>

    <footer class="site-footer">
        <div class="wrap footer-inner">
            <p class="signature">John</p>
            <p class="footer-meta">
                <span id="year"></span> · Colchester, CT · Hand-built, no framework.
            </p>
        </div>
    </footer>

    <script src="/js/site.js" defer></script>
</body>

</html>
